{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "banto-ai benchmark event slice result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "result_type", "matrix_result_path", "matrix_id", "status", "matrix_code_revision", "analyzer_code_revision", "source_matrix_sha256", "counts", "cells", "macro_summary", "research_only_notice", "limitations"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "result_type": {"const": "benchmark-event-slices"},
    "matrix_result_path": {"type": "string", "minLength": 1},
    "matrix_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["success", "partial"]},
    "matrix_code_revision": {"$ref": "#/defs/codeRevision"},
    "analyzer_code_revision": {"$ref": "#/defs/codeRevision"},
    "source_matrix_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "counts": {"$ref": "#/defs/counts"},
    "cells": {"type": "array", "minItems": 1, "items": {"$ref": "#/defs/cell"}},
    "macro_summary": {"type": "array", "items": {"$ref": "#/defs/macro"}},
    "research_only_notice": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "defs": {
    "codeRevision": {"type": "object", "additionalProperties": false, "required": ["status", "head", "dirty", "diff_sha256"], "properties": {"status": {"enum": ["git", "git-unavailable"]}, "head": {"type": ["string", "null"]}, "dirty": {"type": ["boolean", "null"]}, "diff_sha256": {"type": ["string", "null"]}}},
    "counts": {"type": "object", "additionalProperties": false, "required": ["total_cells", "analyzed_cells", "excluded_cells", "excluded_by_status", "total_prediction_count", "analyzed_prediction_count", "forecast_exposure_counts", "context_exposure_counts"], "properties": {"total_cells": {"type": "integer", "minimum": 1}, "analyzed_cells": {"type": "integer", "minimum": 0}, "excluded_cells": {"type": "integer", "minimum": 0}, "excluded_by_status": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}, "total_prediction_count": {"type": "integer", "minimum": 0}, "analyzed_prediction_count": {"type": "integer", "minimum": 0}, "forecast_exposure_counts": {"$ref": "#/defs/forecastCounts"}, "context_exposure_counts": {"$ref": "#/defs/contextCounts"}}},
    "forecastCounts": {"type": "object", "additionalProperties": false, "required": ["target_event", "other_signal_event", "clean"], "properties": {"target_event": {"type": "integer", "minimum": 0}, "other_signal_event": {"type": "integer", "minimum": 0}, "clean": {"type": "integer", "minimum": 0}}},
    "contextCounts": {"type": "object", "additionalProperties": false, "required": ["context_target_event", "context_covariate_event", "context_other_signal_event", "context_clean"], "properties": {"context_target_event": {"type": "integer", "minimum": 0}, "context_covariate_event": {"type": "integer", "minimum": 0}, "context_other_signal_event": {"type": "integer", "minimum": 0}, "context_clean": {"type": "integer", "minimum": 0}}},
    "cell": {"type": "object", "additionalProperties": false, "required": ["cell_id", "run_id", "seed", "horizon", "context_length", "dataset_id", "status", "analyzed", "prediction_count", "analyzed_prediction_count", "excluded_prediction_count", "completeness", "source_failures", "failure", "forecast_exposure_counts", "context_exposure_counts", "operating_mode_counts", "event_coverage", "event_provenance", "metric_rows"], "properties": {"cell_id": {"type": "string", "minLength": 1}, "run_id": {"type": "string", "minLength": 1}, "seed": {"type": "integer", "minimum": 0}, "horizon": {"type": "integer", "minimum": 1}, "context_length": {"type": "integer", "minimum": 2}, "dataset_id": {"type": "string", "minLength": 1}, "status": {"enum": ["success", "partial", "failed"]}, "analyzed": {"type": "boolean"}, "prediction_count": {"type": "integer", "minimum": 0}, "analyzed_prediction_count": {"type": "integer", "minimum": 0}, "excluded_prediction_count": {"type": "integer", "minimum": 0}, "completeness": {"$ref": "#/defs/completeness"}, "source_failures": {"type": "array", "items": {"$ref": "#/defs/failure"}}, "failure": {"anyOf": [{"$ref": "#/defs/matrixFailure"}, {"type": "null"}]}, "forecast_exposure_counts": {"$ref": "#/defs/forecastCounts"}, "context_exposure_counts": {"$ref": "#/defs/contextCounts"}, "operating_mode_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}, "event_coverage": {"type": "array", "items": {"$ref": "#/defs/eventCoverage"}}, "event_provenance": {"type": "object", "description": "Overlap provenance of all event IDs that overlap prediction rows in a priority classification bucket; it is not a list limited to the event selected by priority.", "additionalProperties": false, "required": ["forecast", "context"], "properties": {"forecast": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}}, "context": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}}}}, "metric_rows": {"type": "array", "items": {"$ref": "#/defs/cellMetric"}}}},
    "eventCoverage": {"type": "object", "additionalProperties": false, "required": ["event_id", "event_type", "equipment_id", "signal_id", "roles", "overlaps_test_split", "forecast_point_count", "context_point_count", "covered_by_forecast_timestamp", "covered_by_context_window"], "properties": {"event_id": {"type": "string", "minLength": 1}, "event_type": {"type": "string", "minLength": 1}, "equipment_id": {"type": "string", "minLength": 1}, "signal_id": {"type": "string", "minLength": 1}, "roles": {"type": "array", "items": {"enum": ["target", "covariate", "other"]}}, "overlaps_test_split": {"type": "boolean", "description": "Half-open [start,end) overlap with chronological test split."}, "forecast_point_count": {"type": "integer", "minimum": 0, "description": "Count of overlapping prediction rows; the same event may be counted once per model/target row."}, "context_point_count": {"type": "integer", "minimum": 0}, "covered_by_forecast_timestamp": {"type": "boolean"}, "covered_by_context_window": {"type": "boolean"}}},
    "failure": {"type": "object", "additionalProperties": false, "required": ["model", "equipment_id", "target_signal_id", "status", "reason", "split"], "properties": {"model": {"type": "string", "minLength": 1}, "equipment_id": {"type": "string", "minLength": 1}, "target_signal_id": {"type": "string", "minLength": 1}, "status": {"enum": ["failed", "inconclusive"]}, "reason": {"type": "string", "minLength": 1}, "split": {"enum": ["validation", "test"]}}},
    "matrixFailure": {"type": "object", "additionalProperties": false, "required": ["error_type", "reason"], "properties": {"error_type": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}}},
    "missingGroup": {"type": "object", "additionalProperties": false, "required": ["model", "equipment_id", "target_signal_id", "origin_timestamp", "expected_leads", "observed_leads", "failure_recorded"], "properties": {"model": {"type": "string", "minLength": 1}, "equipment_id": {"type": "string", "minLength": 1}, "target_signal_id": {"type": "string", "minLength": 1}, "origin_timestamp": {"type": "string", "minLength": 1}, "expected_leads": {"type": "array", "items": {"type": "integer", "minimum": 1}}, "observed_leads": {"type": "array", "items": {"type": "integer", "minimum": 1}}, "failure_recorded": {"type": "boolean"}}},
    "completeness": {"type": "object", "additionalProperties": false, "required": ["expected_prediction_count", "observed_prediction_count", "expected_group_count", "observed_group_count", "missing_groups"], "properties": {"expected_prediction_count": {"type": "integer", "minimum": 0}, "observed_prediction_count": {"type": "integer", "minimum": 0}, "expected_group_count": {"type": "integer", "minimum": 0}, "observed_group_count": {"type": "integer", "minimum": 0}, "missing_groups": {"type": "array", "items": {"$ref": "#/defs/missingGroup"}}}},
    "numberSummary": {"type": "object", "additionalProperties": false, "required": ["mean", "min", "max", "sample_stddev"], "properties": {"mean": {"type": "number"}, "min": {"type": "number"}, "max": {"type": "number"}, "sample_stddev": {"type": ["number", "null"]}}},
    "metric": {"type": "object", "additionalProperties": false, "required": ["count", "mae", "rmse", "wis", "nominal_interval_coverage", "interval_width"], "properties": {"count": {"type": "integer", "minimum": 1}, "mae": {"type": "number", "minimum": 0}, "rmse": {"type": "number", "minimum": 0}, "mase": {"type": "number", "minimum": 0}, "mase_status": {"type": "string", "minLength": 1}, "wis": {"type": "number", "minimum": 0}, "nominal_interval_coverage": {"type": "number", "minimum": 0, "maximum": 1}, "interval_width": {"type": "number", "minimum": 0}}, "anyOf": [{"required": ["mase"]}, {"required": ["mase_status"]}]},
    "cellMetric": {"type": "object", "additionalProperties": false, "required": ["dimension", "exposure", "operating_mode", "model", "target_signal_key", "unit", "horizon", "context_length", "metrics"], "properties": {"dimension": {"enum": ["forecast_exposure", "context_exposure", "operating_mode"]}, "exposure": {"type": "string", "minLength": 1}, "operating_mode": {"type": ["string", "null"]}, "model": {"type": "string", "minLength": 1}, "target_signal_key": {"type": "string", "minLength": 1}, "unit": {"type": "string", "minLength": 1}, "horizon": {"type": "integer", "minimum": 1}, "context_length": {"type": "integer", "minimum": 2}, "metrics": {"$ref": "#/defs/metric"}}},
    "macro": {"type": "object", "additionalProperties": false, "required": ["dimension", "exposure", "operating_mode", "model", "target_signal_key", "unit", "horizon", "context_length", "cell_count", "total_point_count", "metrics"], "properties": {"dimension": {"enum": ["forecast_exposure", "context_exposure", "operating_mode"]}, "exposure": {"type": "string", "minLength": 1}, "operating_mode": {"type": ["string", "null"]}, "model": {"type": "string", "minLength": 1}, "target_signal_key": {"type": "string", "minLength": 1}, "unit": {"type": "string", "minLength": 1}, "horizon": {"type": "integer", "minimum": 1}, "context_length": {"type": "integer", "minimum": 2}, "cell_count": {"type": "integer", "minimum": 1}, "total_point_count": {"type": "integer", "minimum": 1}, "metrics": {"type": "object", "additionalProperties": {"$ref": "#/defs/numberSummary"}}}}
  }
}
