{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "banto-ai benchmark run config",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "dataset_path", "output_dir", "horizon", "context_length", "models", "quantiles"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "run_id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "dataset_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*(^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "output_dir": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*(^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "horizon": {"type": "integer", "minimum": 1},
    "context_length": {"type": "integer", "minimum": 2},
    "seed": {"type": "integer", "minimum": 0},
    "target_signal_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "equipment_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "past_only_covariate_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "known_future_covariate_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "validation_origin_stride": {"type": "integer", "minimum": 1},
    "test_origin_stride": {"type": "integer", "minimum": 1},
    "max_validation_origins": {"type": "integer", "minimum": 1},
    "max_test_origins": {"type": "integer", "minimum": 1},
    "quantiles": {"type": "array", "minItems": 3, "items": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}},
    "models": {
      "type": "array", "minItems": 1,
      "items": {"anyOf": [
        {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"const": "last-value"}, "quantile_policy": {"const": "validation-residual-by-lead"}, "parameters": {"type": "object", "additionalProperties": false}}},
        {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"const": "seasonal-naive"}, "quantile_policy": {"const": "validation-residual-by-lead"}, "parameters": {"type": "object", "additionalProperties": false, "properties": {"season_length": {"type": "integer", "minimum": 1}}}}},
        {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"const": "moving-average"}, "quantile_policy": {"const": "validation-residual-by-lead"}, "parameters": {"type": "object", "additionalProperties": false, "properties": {"window": {"type": "integer", "minimum": 1}}}}},
        {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"const": "ewma"}, "quantile_policy": {"const": "validation-residual-by-lead"}, "parameters": {"type": "object", "additionalProperties": false, "properties": {"alpha": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}}}}},
        {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"const": "holt-linear"}, "quantile_policy": {"const": "validation-residual-by-lead"}, "parameters": {"type": "object", "additionalProperties": false, "properties": {"alpha": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "beta": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}}}}},
        {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"const": "linear-regression-covariates"}, "quantile_policy": {"const": "validation-residual-by-lead"}, "parameters": {"type": "object", "additionalProperties": false, "required": ["covariate_ids"], "properties": {"covariate_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}}}
        ,{"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"const": "timesfm3"}, "quantile_policy": {"const": "native"}, "parameters": {"type": "object", "additionalProperties": false, "properties": {"checkpoint_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "per_core_batch_size": {"type": "integer", "minimum": 1}, "device": {"type": "string", "minLength": 1}, "local_files_only": {"type": "boolean"}}}}}
      ]}
    }
  }
}
