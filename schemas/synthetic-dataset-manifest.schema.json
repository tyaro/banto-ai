{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tyaro/banto-ai/schemas/synthetic-dataset-manifest.schema.json",
  "title": "banto-ai generated synthetic dataset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_type", "dataset_id", "provenance", "data_path", "events_path", "split_manifest_path", "fingerprint_path", "generator_config_path", "summary_path", "generator_version", "seed", "sampling_interval_ms", "sample_count", "license", "equipment", "signals"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "manifest_type": {"type": "string", "const": "dataset"},
    "dataset_id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "provenance": {"type": "string", "const": "synthetic"},
    "data_path": {"type": "string", "const": "observations.jsonl"},
    "events_path": {"type": "string", "const": "events.jsonl"},
    "split_manifest_path": {"type": "string", "const": "split-manifest.json"},
    "fingerprint_path": {"type": "string", "const": "fingerprint.json"},
    "generator_config_path": {"type": "string", "const": "generator-config.json"},
    "summary_path": {"type": "string", "const": "summary.json"},
    "generator_version": {"type": "string", "minLength": 1},
    "seed": {"type": "integer", "minimum": 0},
    "sampling_interval_ms": {"type": "integer", "minimum": 1},
    "sample_count": {"type": "integer", "minimum": 1},
    "license": {"type": "string", "const": "MIT"},
    "equipment": {
      "type": "array", "minItems": 2,
      "items": {"type": "object", "additionalProperties": false, "required": ["equipment_id", "equipment_type"], "properties": {"equipment_id": {"type": "string", "minLength": 1}, "equipment_type": {"type": "string", "enum": ["motor", "conveyor"]}}}
    },
    "signals": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["signal_id", "name", "unit", "role", "sampling_interval_ms"], "properties": {"signal_id": {"type": "string", "minLength": 1, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"}, "name": {"type": "string", "minLength": 1}, "unit": {"type": "string", "minLength": 1}, "role": {"type": "string", "enum": ["target", "covariate", "label"]}, "sampling_interval_ms": {"type": "integer", "minimum": 1}}}
    }
  }
}
