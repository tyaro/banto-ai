    "cleanEquipment": {
      "type": "object", "additionalProperties": false,
      "required": ["cell_id", "seed", "layout_id", "layout_index", "equipment_episode_id", "equipment_id", "start_timestamp", "end_timestamp", "source_alert_episode_ids", "merge_size"],
      "properties": {
        "cell_id": {"type": "string", "minLength": 1}, "seed": {"type": "integer"}, "layout_id": {"type": "string", "minLength": 1}, "layout_index": {"type": "integer", "minimum": 0}, "equipment_episode_id": {"type": "string", "minLength": 1}, "equipment_id": {"type": "string", "minLength": 1}, "start_timestamp": {"type": "string", "minLength": 1}, "end_timestamp": {"type": "string", "minLength": 1}, "source_alert_episode_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "merge_size": {"type": "integer", "minimum": 1}
