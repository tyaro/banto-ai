{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tyaro/banto-ai/schemas/anomaly-multiseed-failure-diagnostics-result-v0.1.schema.json",
  "title": "banto-ai exploratory v0.2 anomaly failure diagnostics result v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "result_type", "diagnostics_id", "matrix_id", "status", "run_status", "engineering_status", "performance_status", "exploratory_only", "promotion_eligible", "provenance", "counts", "ledger", "aggregates", "reconciliation", "limitations"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "result_type": {"const": "event-aware-anomaly-failure-diagnostics"},
    "diagnostics_id": {"const": "anomaly-multiseed-v02-diagnostics-v01"},
    "matrix_id": {"const": "anomaly-multiseed-v02"},
    "status": {"const": "complete"},
    "run_status": {"const": "complete"},
    "engineering_status": {"enum": ["pass", "fail", "inconclusive"]},
    "performance_status": {"const": "not_evaluated"},
    "exploratory_only": {"const": true},
    "promotion_eligible": {"const": false},
    "provenance": {"$ref": "#/$defs/provenance"},
    "counts": {"$ref": "#/$defs/counts"},
    "ledger": {"$ref": "#/$defs/ledger"},
    "aggregates": {"$ref": "#/$defs/aggregates"},
    "reconciliation": {"$ref": "#/$defs/reconciliation"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^(?!.*//)(?!.*(?:^|/)[.]{1,2}(?:/|$))(?!.*/$)[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "revision": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "head", "dirty", "diff_sha256"],
      "properties": {
        "status": {"const": "git"},
        "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "dirty": {"const": false},
        "diff_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/digest"}}
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "result_sha256", "summary_sha256", "completion_marker_sha256", "inventory_sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "result_sha256": {"$ref": "#/$defs/digest"},
        "summary_sha256": {"$ref": "#/$defs/digest"},
        "completion_marker_sha256": {"$ref": "#/$defs/digest"},
        "inventory_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["before_inventory_sha256", "after_inventory_sha256", "equal"],
      "properties": {
        "before_inventory_sha256": {"$ref": "#/$defs/digest"},
        "after_inventory_sha256": {"$ref": "#/$defs/digest"},
        "equal": {"const": true}
      }
    },
    "sourceComparison": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "artifact_blob_sha256", "current_raw_sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "artifact_blob_sha256": {"$ref": "#/$defs/digest"},
        "current_raw_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "revisionCompatibility": {
      "type": "object", "additionalProperties": false,
      "required": ["policy", "artifact_revision", "semantic_sources", "current_only_paths", "current_d2_diagnostics"],
      "properties": {
        "policy": {"type": "string", "minLength": 1},
        "artifact_revision": {"$ref": "#/$defs/revision"},
        "semantic_sources": {"type": "array", "items": {"$ref": "#/$defs/sourceComparison"}},
        "current_only_paths": {"type": "array", "items": {"$ref": "#/$defs/path"}},
        "current_d2_diagnostics": {"$ref": "#/$defs/d2Diagnostics"}
      }
    },
    "d2Diagnostics": {
      "type": "object", "additionalProperties": false,
      "required": ["module_raw_sha256", "cli_raw_sha256", "renderer_raw_sha256", "schema_raw_sha256", "config_raw_sha256"],
      "properties": {
        "module_raw_sha256": {"$ref": "#/$defs/digest"},
        "cli_raw_sha256": {"$ref": "#/$defs/digest"},
        "renderer_raw_sha256": {"$ref": "#/$defs/digest"},
        "schema_raw_sha256": {"$ref": "#/$defs/digest"},
        "config_raw_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["canonicalization", "artifact_code_revision", "replay_code_revision", "input_artifact", "input_snapshot", "revision_compatibility", "config", "config_schema", "result_schema"],
      "properties": {
        "canonicalization": {"const": "utf-8-json-sort-keys-compact-no-trailing-newline-v1"},
        "artifact_code_revision": {"$ref": "#/$defs/revision"},
        "replay_code_revision": {"$ref": "#/$defs/revision"},
        "input_artifact": {"$ref": "#/$defs/artifact"},
        "input_snapshot": {"$ref": "#/$defs/snapshot"},
        "revision_compatibility": {"$ref": "#/$defs/revisionCompatibility"},
        "config": {"$ref": "#/$defs/source"},
        "config_schema": {"$ref": "#/$defs/source"},
        "result_schema": {"$ref": "#/$defs/source"}
      }
    },
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["cells", "seed_clusters", "layouts_per_seed", "events_per_seed", "seed_values", "event_rows", "eligible_incident_windows", "pre_event_support_rows", "detection_window_point_rows", "combined_incident_point_rows", "score_availability_source_points", "availability_group_rows", "calibration_profile_rows", "aggregate_signal_mode_groups", "clean_aggregate_rows", "incident_window_aggregate_rows", "incident_offset_aggregate_rows", "clean_reconciliation_rows", "availability_aggregate_rows", "calibration_aggregate_rows", "cardinality_formulas"],
      "properties": {
        "cells": {"const": 120}, "seed_clusters": {"const": 10}, "layouts_per_seed": {"const": 12}, "events_per_seed": {"const": 48},
        "seed_values": {"const": [11, 17, 23, 29, 37, 42, 53, 67, 79, 97]},
        "event_rows": {"const": 480}, "eligible_incident_windows": {"const": 240}, "pre_event_support_rows": {"const": 240},
        "detection_window_point_rows": {"const": 1440}, "combined_incident_point_rows": {"const": 1680},
        "score_availability_source_points": {"const": 172800}, "availability_group_rows": {"const": 5760},
        "calibration_profile_rows": {"const": 5760}, "aggregate_signal_mode_groups": {"const": 48}, "clean_aggregate_rows": {"const": 94}, "incident_window_aggregate_rows": {"const": 16}, "incident_offset_aggregate_rows": {"const": 112}, "clean_reconciliation_rows": {"const": 240}, "availability_aggregate_rows": {"const": 48}, "calibration_aggregate_rows": {"const": 48},
        "cardinality_formulas": {
          "type": "object", "additionalProperties": false,
          "required": ["event_rows", "eligible_incident_windows", "pre_event_support_rows", "detection_window_point_rows", "combined_incident_point_rows", "score_availability_source_points", "availability_group_rows", "calibration_profile_rows", "aggregate_signal_mode_groups", "clean_aggregate_rows", "incident_window_aggregate_rows", "incident_offset_aggregate_rows", "clean_reconciliation_rows", "availability_aggregate_rows", "calibration_aggregate_rows"],
          "properties": {
            "event_rows": {"const": "seed_clusters*events_per_seed=10*48=480"},
            "eligible_incident_windows": {"const": "seed_clusters*(events_per_seed/2)=10*(48/2)=240"},
            "pre_event_support_rows": {"const": "eligible_incident_windows*1=240*1=240"},
            "detection_window_point_rows": {"const": "eligible_incident_windows*6=240*6=1440"},
            "combined_incident_point_rows": {"const": "eligible_incident_windows*(1+6)=240*7=1680"},
            "score_availability_source_points": {"const": "cells*1440=120*1440=172800"},
            "availability_group_rows": {"const": "cells*aggregate_signal_mode_groups=120*48=5760"},
            "calibration_profile_rows": {"const": "cells*aggregate_signal_mode_groups=120*48=5760"},
            "aggregate_signal_mode_groups": {"const": "8_fully_qualified_signals*6_operating_modes=48"},
            "clean_aggregate_rows": {"const": "8+6+48+2+30=94"},
            "incident_window_aggregate_rows": {"const": "2+2+4+2+6=16"},
            "incident_offset_aggregate_rows": {"const": "16*7=112"},
            "clean_reconciliation_rows": {"const": "cells*equipment=120*2=240"},
            "availability_aggregate_rows": {"const": "8*6=48"},
            "calibration_aggregate_rows": {"const": "8*6=48"}
          }
        }
      }
    },
    "profileKey": {
      "type": "object", "additionalProperties": false,
      "required": ["equipment_id", "signal_id", "operating_mode"],
      "properties": {"equipment_id": {"$ref": "#/$defs/canonicalEquipmentId"}, "signal_id": {"$ref": "#/$defs/canonicalSignalId"}, "operating_mode": {"$ref": "#/$defs/canonicalOperatingMode"}}
    },
    "canonicalSignalId": {"enum": ["motor-01.motor_current", "motor-01.motor_temperature", "motor-01.conveyor_speed", "motor-01.vibration_feature", "conveyor-01.motor_current", "conveyor-01.motor_temperature", "conveyor-01.conveyor_speed", "conveyor-01.vibration_feature"]},
    "canonicalOperatingMode": {"enum": ["stopped", "startup", "low_speed", "nominal", "high_load", "cooldown"]},
    "canonicalEquipmentId": {"enum": ["motor-01", "conveyor-01"]},
    "canonicalSignalModePair": {
