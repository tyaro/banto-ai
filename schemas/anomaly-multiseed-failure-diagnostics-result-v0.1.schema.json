        "equipment_id": {"enum": ["motor-01", "conveyor-01"]}, "signal_id": {"enum": ["motor-01.motor_current", "conveyor-01.conveyor_speed", "motor-01.motor_temperature", "conveyor-01.motor_temperature"]}, "operating_mode": {"enum": ["stopped", "startup", "low_speed", "nominal", "high_load", "cooldown"]},
        "event_start_timestamp": {"type": "string", "minLength": 1}, "event_end_timestamp": {"type": "string", "minLength": 1}, "detection_window_start": {"type": "string", "minLength": 1}, "detection_window_end": {"type": "string", "minLength": 1},
        "detected": {"type": "boolean"}, "matched_alert_episode_id": {"type": ["string", "null"]}, "alert_onset_timestamp": {"type": ["string", "null"]}, "detection_delay_seconds": {"type": ["number", "null"], "minimum": 0},
        "max_in_window_consecutive_exceedances": {"type": "integer", "minimum": 0}, "pre_event_support": {"type": "boolean"}, "event_causal_support_qualified": {"type": "boolean"}
