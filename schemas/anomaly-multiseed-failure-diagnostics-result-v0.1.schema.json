        "event_id": {"type": "string", "minLength": 1}, "event_class": {"enum": ["machine_fault", "sensor_fault"]}, "event_type": {"enum": ["jam_or_slip", "spike"]},
        "equipment_id": {"enum": ["motor-01", "conveyor-01"]}, "signal_id": {"enum": ["motor-01.motor_current", "conveyor-01.conveyor_speed", "motor-01.motor_temperature", "conveyor-01.motor_temperature"]}, "operating_mode": {"enum": ["stopped", "startup", "low_speed", "nominal", "high_load", "cooldown"]},
        "offset": {"enum": [-1, 0, 1, 2, 3, 4, 5]}, "timestamp": {"type": "string", "minLength": 1}, "quality_status": {"enum": ["ok", "missing", "stale"]},
        "actual": {"type": ["number", "null"]}, "previous_actual": {"type": ["number", "null"]}, "residual": {"type": ["number", "null"]}, "available": {"type": "boolean"}, "exclusion_reason": {"type": ["string", "null"]}, "score": {"type": ["number", "null"], "minimum": 0}, "exceeds_threshold": {"type": "boolean"}, "persistence_streak": {"type": "integer", "minimum": 0}, "alert_episode_id": {"type": ["string", "null"]}
      }
    },
    "cleanSource": {
      "type": "object", "additionalProperties": false,
      "required": ["cell_id", "seed", "layout_id", "layout_index", "source_alert_episode_id", "equipment_id", "signal_id", "operating_mode", "onset_timestamp", "end_timestamp", "point_count", "max_score", "mode_entry_offset", "equipment_episode_id"],
      "properties": {
        "cell_id": {"type": "string", "minLength": 1}, "seed": {"type": "integer"}, "layout_id": {"type": "string", "minLength": 1}, "layout_index": {"type": "integer", "minimum": 0}, "source_alert_episode_id": {"type": "string", "minLength": 1}, "equipment_id": {"type": "string", "minLength": 1}, "signal_id": {"type": "string", "minLength": 1}, "operating_mode": {"type": "string", "minLength": 1}, "onset_timestamp": {"type": "string", "minLength": 1}, "end_timestamp": {"type": "string", "minLength": 1}, "point_count": {"type": "integer", "minimum": 1}, "max_score": {"type": "number", "minimum": 0}, "mode_entry_offset": {"type": "integer", "minimum": 0, "maximum": 29}, "equipment_episode_id": {"type": "string", "minLength": 1}
      }
