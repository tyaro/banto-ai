    },
    "incidentWindow": {
      "type": "object", "additionalProperties": false,
      "required": ["cell_id", "seed", "layout_id", "layout_index", "event_id", "event_class", "event_type", "equipment_id", "signal_id", "operating_mode", "event_start_timestamp", "event_end_timestamp", "detection_window_start", "detection_window_end", "detected", "matched_alert_episode_id", "alert_onset_timestamp", "detection_delay_seconds", "max_in_window_consecutive_exceedances", "pre_event_support", "event_causal_support_qualified"],
      "properties": {
