{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tyaro/banto-ai/schemas/dataset-manifest.schema.json",
  "title": "banto-ai dataset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_type", "dataset_id", "provenance", "data_path", "license", "signals"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "manifest_type": {"type": "string", "const": "dataset"},
    "dataset_id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "provenance": {"type": "string", "enum": ["synthetic", "public"]},
    "data_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "license": {"type": "string", "minLength": 1},
    "events_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "split_manifest_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "fingerprint_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "generator_config_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "summary_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "generator_version": {"type": "string", "minLength": 1},
    "seed": {"type": "integer", "minimum": 0},
    "sampling_interval_ms": {"type": "integer", "minimum": 1},
    "sample_count": {"type": "integer", "minimum": 1},
    "equipment": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["equipment_id", "equipment_type"], "properties": {"equipment_id": {"type": "string", "minLength": 1}, "equipment_type": {"type": "string", "enum": ["motor", "conveyor"]}}}},
    "signals": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["signal_id", "name", "unit", "role", "sampling_interval_ms"],
        "properties": {
          "signal_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "unit": {"type": "string", "minLength": 1},
          "role": {"type": "string", "enum": ["target", "covariate", "label"]},
          "sampling_interval_ms": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
