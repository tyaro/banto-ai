{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "banto-ai benchmark matrix config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "matrix_id",
    "generator_config_path",
    "benchmark_config_path",
    "dataset_output_root",
    "benchmark_output_root",
    "matrix_output_dir",
    "axes"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "matrix_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "generator_config_path": {"$ref": "#/$defs/repositoryPath"},
    "benchmark_config_path": {"$ref": "#/$defs/repositoryPath"},
    "dataset_output_root": {"$ref": "#/$defs/repositoryPath"},
    "benchmark_output_root": {"$ref": "#/$defs/repositoryPath"},
    "matrix_output_dir": {"$ref": "#/$defs/repositoryPath"},
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seeds", "horizons", "context_lengths"],
      "properties": {
        "seeds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "horizons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "context_lengths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 2}
        }
      }
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$"
    }
  }
}
