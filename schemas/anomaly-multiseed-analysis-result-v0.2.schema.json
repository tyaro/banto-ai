    "bootstrap": {"type": "object", "additionalProperties": false, "required": ["algorithm_id", "seed", "resamples", "cluster_count", "layouts_per_cluster", "events_per_cluster", "confidence_level", "percentile_method", "draw_digest", "undefined_replicates"], "properties": {"algorithm_id": {"const": "sha256-counter-rejection-v1"}, "seed": {"const": 20260905}, "resamples": {"const": 10000}, "cluster_count": {"const": 10}, "layouts_per_cluster": {"const": 12}, "events_per_cluster": {"const": 48}, "confidence_level": {"const": 0.95}, "percentile_method": {"const": "linear_interpolation_n_minus_1"}, "draw_digest": {"const": "5b311c270aaef7bb942e0c4fbe761e8e225aaa0a1314a8bd2e70875f0fd46548"}, "undefined_replicates": {"type": "object", "additionalProperties": false, "required": ["overall_incident_precision", "machine_fault_recall", "sensor_fault_recall", "clean_false_alerts_per_8_equipment_hours"], "properties": {"overall_incident_precision": {"type": "integer", "minimum": 0}, "machine_fault_recall": {"type": "integer", "minimum": 0}, "sensor_fault_recall": {"type": "integer", "minimum": 0}, "clean_false_alerts_per_8_equipment_hours": {"type": "integer", "minimum": 0}}}}},
