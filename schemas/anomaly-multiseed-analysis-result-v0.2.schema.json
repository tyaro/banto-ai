{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tyaro/banto-ai/schemas/anomaly-multiseed-analysis-result-v0.2.schema.json",
  "title": "banto-ai event-aware anomaly matrix analysis result v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "result_type", "analysis_id", "matrix_id", "status", "run_status", "engineering_status", "performance_status", "provenance", "counts", "estimates", "bootstrap", "promotion_gates", "limitations"],
  "properties": {
    "schema_version": {"const": "0.2"}, "result_type": {"const": "event-aware-anomaly-matrix-analysis"}, "analysis_id": {"const": "anomaly-multiseed-analysis-v02"}, "matrix_id": {"const": "anomaly-multiseed-v02"},
    "status": {"enum": ["pass", "fail", "inconclusive"]}, "run_status": {"const": "complete"}, "engineering_status": {"enum": ["pass", "fail", "inconclusive"]}, "performance_status": {"enum": ["pass", "fail", "inconclusive"]},
    "provenance": {"$ref": "#/$defs/provenance"}, "counts": {"$ref": "#/$defs/counts"}, "estimates": {"$ref": "#/$defs/estimates"}, "bootstrap": {"$ref": "#/$defs/bootstrap"}, "promotion_gates": {"type": "object", "additionalProperties": {"$ref": "#/$defs/gate"}}, "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^(?!.*//)(?!.*(?:^|/)[.]{1,2}(?:/|$))(?!.*/$)[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "source": {"type": "object", "additionalProperties": false, "required": ["path", "raw_sha256", "canonical_sha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "raw_sha256": {"$ref": "#/$defs/digest"}, "canonical_sha256": {"$ref": "#/$defs/digest"}}},
    "revision": {"type": "object", "additionalProperties": false, "required": ["status", "head", "dirty", "diff_sha256"], "properties": {"status": {"const": "git"}, "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "dirty": {"const": false}, "diff_sha256": {"$ref": "#/$defs/digest"}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["canonicalization", "inputs", "code_revision", "bootstrap_algorithm_id", "bootstrap_draw_digest"], "properties": {"canonicalization": {"const": "utf-8-json-sort-keys-compact-no-trailing-newline-v1"}, "inputs": {"type": "object", "additionalProperties": false, "required": ["analysis_config", "analysis_schema", "matrix_artifact", "matrix_sources"], "properties": {"analysis_config": {"$ref": "#/$defs/source"}, "analysis_schema": {"$ref": "#/$defs/source"}, "matrix_artifact": {"type": "object", "additionalProperties": false, "required": ["path", "inventory_sha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "inventory_sha256": {"$ref": "#/$defs/digest"}}}, "matrix_sources": {"type": "object", "additionalProperties": {"$ref": "#/$defs/source"}}}}, "code_revision": {"$ref": "#/$defs/revision"}, "bootstrap_algorithm_id": {"const": "sha256-counter-rejection-v1"}, "bootstrap_draw_digest": {"$ref": "#/$defs/digest"}}},
    "counts": {"type": "object", "additionalProperties": false, "required": ["cells_verified", "seeds", "layouts_per_seed", "events_per_seed", "bootstrap_resamples", "bootstrap_clusters"], "properties": {"cells_verified": {"const": 120}, "seeds": {"const": 10}, "layouts_per_seed": {"const": 12}, "events_per_seed": {"const": 48}, "bootstrap_resamples": {"const": 10000}, "bootstrap_clusters": {"const": 10}}},
    "ci": {"type": "object", "additionalProperties": false, "required": ["status", "lower", "upper", "undefined_replicates"], "properties": {"status": {"enum": ["pass", "inconclusive"]}, "lower": {"type": ["number", "null"]}, "upper": {"type": ["number", "null"]}, "undefined_replicates": {"type": "integer", "minimum": 0}}},
    "metric": {"type": "object", "additionalProperties": false, "required": ["numerator", "denominator", "value", "ci"], "properties": {"numerator": {"type": ["number", "null"]}, "denominator": {"type": ["number", "null"]}, "value": {"type": ["number", "null"]}, "ci": {"$ref": "#/$defs/ci"}}},
    "availability": {"type": "object", "additionalProperties": false, "required": ["available_points", "total_points", "availability_ratio"], "properties": {"available_points": {"type": "integer", "minimum": 0}, "total_points": {"type": "integer", "minimum": 0}, "availability_ratio": {"type": ["number", "null"]}}},
    "slice": {"type": "object", "additionalProperties": false, "required": ["eligible_incidents", "detected_incidents", "incident_recall", "detection_delay_seconds"], "properties": {"eligible_incidents": {"type": "integer", "minimum": 0}, "detected_incidents": {"type": "integer", "minimum": 0}, "incident_recall": {"type": ["number", "null"]}, "detection_delay_seconds": {"type": "object", "additionalProperties": false, "required": ["count", "mean_seconds", "median_seconds"], "properties": {"count": {"type": "integer", "minimum": 0}, "mean_seconds": {"type": ["number", "null"]}, "median_seconds": {"type": ["number", "null"]}}}}},
    "estimates": {"type": "object", "additionalProperties": false, "required": ["primary", "availability_by_signal", "incident_slices"], "properties": {"primary": {"type": "object", "additionalProperties": false, "required": ["overall_incident_precision", "machine_fault_recall", "sensor_fault_recall", "clean_false_alerts_per_8_equipment_hours"], "properties": {"overall_incident_precision": {"$ref": "#/$defs/metric"}, "machine_fault_recall": {"$ref": "#/$defs/metric"}, "sensor_fault_recall": {"$ref": "#/$defs/metric"}, "clean_false_alerts_per_8_equipment_hours": {"$ref": "#/$defs/metric"}}}, "availability_by_signal": {"type": "object", "minProperties": 8, "additionalProperties": {"$ref": "#/$defs/availability"}}, "incident_slices": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/slice"}}}},
    "bootstrap": {"type": "object", "additionalProperties": false, "required": ["algorithm_id", "seed", "resamples", "cluster_count", "layouts_per_cluster", "events_per_cluster", "confidence_level", "percentile_method", "draw_digest", "undefined_replicates"], "properties": {"algorithm_id": {"const": "sha256-counter-rejection-v1"}, "seed": {"const": 20260905}, "resamples": {"const": 10000}, "cluster_count": {"const": 10}, "layouts_per_cluster": {"const": 12}, "events_per_cluster": {"const": 48}, "confidence_level": {"const": 0.95}, "percentile_method": {"const": "linear_interpolation_n_minus_1"}, "draw_digest": {"$ref": "#/$defs/digest"}, "undefined_replicates": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}}},
    "gate": {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"enum": ["pass", "fail", "inconclusive"]}, "point": {"type": ["number", "null"]}, "ci_lower": {"type": ["number", "null"]}, "ci_upper": {"type": ["number", "null"]}, "threshold": {"type": "object"}, "minimum": {"type": "number"}, "signals": {"type": "object"}}}
  }
}
