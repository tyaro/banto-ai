    "metric": {"type": "object", "additionalProperties": false, "required": ["numerator", "denominator", "value", "ci"], "properties": {"numerator": {"type": ["number", "null"]}, "denominator": {"type": ["number", "null"]}, "value": {"type": ["number", "null"]}, "ci": {"$ref": "#/$defs/ci"}}},
