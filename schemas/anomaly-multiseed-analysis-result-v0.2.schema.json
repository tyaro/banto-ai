    "precisionSlice": {"type": "object", "additionalProperties": false, "required": ["scope", "numerator", "denominator", "value", "ci", "not_for_promotion"], "properties": {"scope": {"enum": ["by_equipment", "by_mode", "equipment×mode"]}, "numerator": {"type": "integer", "minimum": 0}, "denominator": {"type": "integer", "minimum": 0}, "value": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "ci": {"$ref": "#/$defs/ci"}, "not_for_promotion": {"const": "descriptive attribution only; class precision is not applicable"}}},
