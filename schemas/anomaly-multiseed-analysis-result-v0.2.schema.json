    "source": {"type": "object", "additionalProperties": false, "required": ["path", "raw_sha256", "canonical_sha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "raw_sha256": {"$ref": "#/$defs/digest"}, "canonical_sha256": {"$ref": "#/$defs/digest"}}},
    "revision": {"type": "object", "additionalProperties": false, "required": ["status", "head", "dirty", "diff_sha256"], "properties": {"status": {"const": "git"}, "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "dirty": {"const": false}, "diff_sha256": {"$ref": "#/$defs/digest"}}},
    "matrixSources": {"type": "object", "additionalProperties": false, "required": ["matrix_config", "matrix_schema", "base_generator_config", "base_generator_schema", "anomaly_config_schema", "anomaly_result_schema", "dataset_manifest_schema", "matrix_result_schema"], "properties": {"matrix_config": {"$ref": "#/$defs/source"}, "matrix_schema": {"$ref": "#/$defs/source"}, "base_generator_config": {"$ref": "#/$defs/source"}, "base_generator_schema": {"$ref": "#/$defs/source"}, "anomaly_config_schema": {"$ref": "#/$defs/source"}, "anomaly_result_schema": {"$ref": "#/$defs/source"}, "dataset_manifest_schema": {"$ref": "#/$defs/source"}, "matrix_result_schema": {"$ref": "#/$defs/source"}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["canonicalization", "inputs", "code_revision", "bootstrap_algorithm_id", "bootstrap_draw_digest"], "properties": {"canonicalization": {"const": "utf-8-json-sort-keys-compact-no-trailing-newline-v1"}, "inputs": {"type": "object", "additionalProperties": false, "required": ["analysis_config", "analysis_schema", "analysis_result_schema", "matrix_artifact", "matrix_sources"], "properties": {"analysis_config": {"$ref": "#/$defs/source"}, "analysis_schema": {"$ref": "#/$defs/source"}, "analysis_result_schema": {"$ref": "#/$defs/source"}, "matrix_artifact": {"type": "object", "additionalProperties": false, "required": ["path", "inventory_sha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "inventory_sha256": {"$ref": "#/$defs/digest"}}}, "matrix_sources": {"$ref": "#/$defs/matrixSources"}}}, "code_revision": {"$ref": "#/$defs/revision"}, "bootstrap_algorithm_id": {"const": "sha256-counter-rejection-v1"}, "bootstrap_draw_digest": {"$ref": "#/$defs/digest"}}},
