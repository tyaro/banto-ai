    "gates": {"type": "object", "additionalProperties": false, "required": ["overall_incident_precision", "machine_fault_recall", "sensor_fault_recall", "clean_false_alerts_per_8_equipment_hours", "signal_availability"], "properties": {"overall_incident_precision": {"$ref": "#/$defs/gate"}, "machine_fault_recall": {"$ref": "#/$defs/gate"}, "sensor_fault_recall": {"$ref": "#/$defs/gate"}, "clean_false_alerts_per_8_equipment_hours": {"$ref": "#/$defs/gate"}, "signal_availability": {"$ref": "#/$defs/gate"}}}
