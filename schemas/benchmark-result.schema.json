{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "banto-ai benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "result_type", "run_id", "status", "dataset_fingerprint", "generator_version", "run_config", "code_revision", "seed", "model_parameters", "prediction_count", "failures", "metrics", "runtime", "provenance"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"}, "result_type": {"type": "string", "const": "benchmark"}, "run_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["success", "partial"]}, "dataset_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "generator_version": {"type": "string", "minLength": 1},
    "run_config": {"$ref": "#/$defs/runConfig"}, "code_revision": {"$ref": "#/$defs/codeRevision"}, "seed": {"type": ["integer", "null"]},
    "model_parameters": {"type": "object", "additionalProperties": {"$ref": "#/$defs/modelParameters"}}, "prediction_count": {"type": "integer", "minimum": 1},
    "failures": {"type": "array", "items": {"$ref": "#/$defs/failure"}},
    "metrics": {"type": "object", "additionalProperties": false, "required": ["aggregate", "slices"], "properties": {"aggregate": {"$ref": "#/$defs/metric"}, "slices": {"type": "object", "additionalProperties": {"$ref": "#/$defs/metric"}}}},
    "runtime": {"$ref": "#/$defs/runtime"}, "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "runConfig": {
      "type": "object", "additionalProperties": false, "required": ["schema_version", "run_id", "dataset_path", "output_dir", "horizon", "context_length", "models", "quantiles"],
      "properties": {
        "schema_version": {"type": "string", "const": "0.1"}, "run_id": {"type": "string", "minLength": 1}, "dataset_path": {"type": "string", "minLength": 1}, "output_dir": {"type": "string", "minLength": 1},
        "horizon": {"type": "integer", "minimum": 1}, "context_length": {"type": "integer", "minimum": 2}, "seed": {"type": ["integer", "null"]},
        "target_signal_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}, "equipment_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "quantiles": {"type": "array", "minItems": 3, "items": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}},
        "models": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}, "parameters": {"type": "object"}}}}
      }
    },
    "codeRevision": {"type": "object", "additionalProperties": false, "required": ["status", "head", "dirty", "diff_sha256"], "properties": {"status": {"type": "string", "enum": ["git", "git-unavailable"]}, "head": {"type": ["string", "null"]}, "dirty": {"type": ["boolean", "null"]}, "diff_sha256": {"type": ["string", "null"]}}},
    "modelParameters": {"type": "object", "additionalProperties": false, "properties": {"season_length": {"type": "integer", "minimum": 1}, "window": {"type": "integer", "minimum": 1}, "alpha": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "beta": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "covariate_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "metric": {"type": "object", "additionalProperties": false, "required": ["count", "mae", "rmse", "wis", "nominal_interval_coverage", "interval_width"], "properties": {"count": {"type": "integer", "minimum": 1}, "mae": {"type": "number", "minimum": 0}, "rmse": {"type": "number", "minimum": 0}, "mase": {"type": "number", "minimum": 0}, "mase_status": {"type": "string", "minLength": 1}, "wis": {"type": "number", "minimum": 0}, "nominal_interval_coverage": {"type": "number", "minimum": 0, "maximum": 1}, "interval_width": {"type": "number", "minimum": 0}}, "anyOf": [{"required": ["mase"]}, {"required": ["mase_status"]}]},
    "failure": {"type": "object", "additionalProperties": false, "required": ["model", "equipment_id", "target_signal_id", "status", "reason", "split"], "properties": {"model": {"type": "string", "minLength": 1}, "equipment_id": {"type": "string", "minLength": 1}, "target_signal_id": {"type": "string", "minLength": 1}, "status": {"type": "string", "enum": ["failed", "inconclusive"]}, "reason": {"type": "string", "minLength": 1}, "split": {"type": "string", "enum": ["validation", "test"]}}},
    "runtime": {"type": "object", "additionalProperties": false, "required": ["validation_seconds", "test_seconds", "total_seconds", "p50_latency_ms", "p95_latency_ms", "peak_memory_bytes", "model_state_bytes", "output_size_bytes_excluding_result", "os", "python", "cpu", "calibration_source"], "properties": {"validation_seconds": {"type": "number", "minimum": 0}, "test_seconds": {"type": "number", "minimum": 0}, "total_seconds": {"type": "number", "minimum": 0}, "p50_latency_ms": {"type": "number", "minimum": 0}, "p95_latency_ms": {"type": "number", "minimum": 0}, "peak_memory_bytes": {"type": "integer", "minimum": 0}, "model_state_bytes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 0}}, "output_size_bytes_excluding_result": {"type": "integer", "minimum": 0}, "os": {"type": "string", "minLength": 1}, "python": {"type": "string", "minLength": 1}, "cpu": {"type": "string"}, "calibration_source": {"type": "string", "minLength": 1}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["quality_gate", "split", "quantile_calibration"], "properties": {"quality_gate": {"type": "object", "additionalProperties": false, "required": ["status", "observation_record_count", "equipment_count", "checks"], "properties": {"status": {"const": "pass"}, "observation_record_count": {"type": "integer", "minimum": 1}, "equipment_count": {"type": "integer", "minimum": 1}, "checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}, "split": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["train", "validation", "test"], "properties": {"train": {"$ref": "#/$defs/splitBounds"}, "validation": {"$ref": "#/$defs/splitBounds"}, "test": {"$ref": "#/$defs/splitBounds"}}}}, "quantile_calibration": {"type": "string", "minLength": 1}}},
    "splitBounds": {"type": "object", "additionalProperties": false, "required": ["start_index", "end_index"], "properties": {"start_index": {"type": "integer", "minimum": 0}, "end_index": {"type": "integer", "minimum": 1}}}
  }
}
