{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "banto-ai benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "result_type", "run_id", "status", "dataset_fingerprint", "generator_version", "run_config", "code_revision", "seed", "model_parameters", "prediction_count", "failures", "metrics", "runtime", "provenance"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.2"}, "result_type": {"type": "string", "const": "benchmark"}, "run_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["success", "partial"]}, "dataset_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "generator_version": {"type": "string", "minLength": 1},
    "run_config": {"$ref": "#/$defs/runConfig"}, "code_revision": {"$ref": "#/$defs/codeRevision"}, "seed": {"type": ["integer", "null"]},
    "model_parameters": {"type": "object", "additionalProperties": {"$ref": "#/$defs/modelParameters"}}, "prediction_count": {"type": "integer", "minimum": 1},
    "failures": {"type": "array", "items": {"$ref": "#/$defs/failure"}},
    "metrics": {"type": "object", "additionalProperties": false, "required": ["aggregate", "by_model", "slices", "by_model_target", "by_model_equipment_target"], "properties": {"aggregate": {"$ref": "#/$defs/metric"}, "by_model": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/metric"}}, "slices": {"type": "object", "additionalProperties": {"$ref": "#/$defs/metric"}}, "by_model_target": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/modelTargetMetric"}}, "by_model_equipment_target": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/modelEquipmentTargetMetric"}}}},
    "runtime": {"$ref": "#/$defs/runtime"}, "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "runConfig": {
      "type": "object", "additionalProperties": false, "required": ["schema_version", "run_id", "dataset_path", "output_dir", "horizon", "context_length", "models", "quantiles"],
      "properties": {
        "schema_version": {"type": "string", "const": "0.1"}, "run_id": {"type": "string", "minLength": 1}, "dataset_path": {"type": "string", "minLength": 1}, "output_dir": {"type": "string", "minLength": 1},
        "horizon": {"type": "integer", "minimum": 1}, "context_length": {"type": "integer", "minimum": 2}, "seed": {"type": ["integer", "null"]},
        "target_signal_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}, "equipment_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "quantiles": {"type": "array", "minItems": 3, "items": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}},
        "past_only_covariate_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}, "known_future_covariate_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "validation_origin_stride": {"type": "integer", "minimum": 1}, "test_origin_stride": {"type": "integer", "minimum": 1}, "max_validation_origins": {"type": "integer", "minimum": 1}, "max_test_origins": {"type": "integer", "minimum": 1},
        "models": {"type": "array", "minItems": 1, "items": {"anyOf": [
          {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"const": "last-value"}, "quantile_policy": {"const": "validation-residual-by-lead"}, "parameters": {"type": "object", "additionalProperties": false}}},
          {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"const": "seasonal-naive"}, "quantile_policy": {"const": "validation-residual-by-lead"}, "parameters": {"type": "object", "additionalProperties": false, "properties": {"season_length": {"type": "integer", "minimum": 1}}}}},
          {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"const": "moving-average"}, "quantile_policy": {"const": "validation-residual-by-lead"}, "parameters": {"type": "object", "additionalProperties": false, "properties": {"window": {"type": "integer", "minimum": 1}}}}},
          {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"const": "ewma"}, "quantile_policy": {"const": "validation-residual-by-lead"}, "parameters": {"type": "object", "additionalProperties": false, "properties": {"alpha": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}}}}},
          {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"const": "holt-linear"}, "quantile_policy": {"const": "validation-residual-by-lead"}, "parameters": {"type": "object", "additionalProperties": false, "properties": {"alpha": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "beta": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}}}}},
          {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"const": "linear-regression-covariates"}, "quantile_policy": {"const": "validation-residual-by-lead"}, "parameters": {"type": "object", "additionalProperties": false, "required": ["covariate_ids"], "properties": {"covariate_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}}},
          {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"const": "timesfm3"}, "quantile_policy": {"const": "native"}, "parameters": {"type": "object", "additionalProperties": false, "properties": {"checkpoint_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "per_core_batch_size": {"type": "integer", "minimum": 1}, "device": {"type": "string", "minLength": 1}, "local_files_only": {"type": "boolean"}}}}},
          {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"const": "chronos2"}, "quantile_policy": {"enum": ["native", "validation-residual-by-lead"]}, "parameters": {"type": "object", "additionalProperties": false, "properties": {"checkpoint_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "batch_size": {"type": "integer", "minimum": 1}, "context_length": {"type": "integer", "minimum": 2, "maximum": 8192}, "cross_learning": {"type": "boolean"}, "device_map": {"type": "string", "minLength": 1}, "local_files_only": {"type": "boolean"}}}}}
        ]}}
      }
    },
    "codeRevision": {"type": "object", "additionalProperties": false, "required": ["status", "head", "dirty", "diff_sha256"], "properties": {"status": {"type": "string", "enum": ["git", "git-unavailable"]}, "head": {"type": ["string", "null"]}, "dirty": {"type": ["boolean", "null"]}, "diff_sha256": {"type": ["string", "null"]}}},
    "modelParameters": {"type": "object", "additionalProperties": false, "properties": {"season_length": {"type": "integer", "minimum": 1}, "window": {"type": "integer", "minimum": 1}, "alpha": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "beta": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "covariate_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "checkpoint_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "per_core_batch_size": {"type": "integer", "minimum": 1}, "device": {"type": "string", "minLength": 1}, "device_map": {"type": "string", "minLength": 1}, "batch_size": {"type": "integer", "minimum": 1}, "context_length": {"type": "integer", "minimum": 2, "maximum": 8192}, "cross_learning": {"type": "boolean"}, "local_files_only": {"type": "boolean"}}},
    "metric": {"type": "object", "additionalProperties": false, "required": ["count", "mae", "rmse", "wis", "nominal_interval_coverage", "interval_width"], "properties": {"count": {"type": "integer", "minimum": 1}, "mae": {"type": "number", "minimum": 0}, "rmse": {"type": "number", "minimum": 0}, "mase": {"type": "number", "minimum": 0}, "mase_status": {"type": "string", "minLength": 1}, "wis": {"type": "number", "minimum": 0}, "nominal_interval_coverage": {"type": "number", "minimum": 0, "maximum": 1}, "interval_width": {"type": "number", "minimum": 0}}, "anyOf": [{"required": ["mase"]}, {"required": ["mase_status"]}]},
    "modelTargetMetric": {"type": "object", "additionalProperties": false, "required": ["model", "target_signal_key", "unit", "metrics"], "properties": {"model": {"type": "string", "minLength": 1}, "target_signal_key": {"type": "string", "minLength": 1}, "unit": {"type": "string", "minLength": 1}, "metrics": {"$ref": "#/$defs/metric"}}},
    "modelEquipmentTargetMetric": {"type": "object", "additionalProperties": false, "required": ["model", "equipment_id", "target_signal_id", "unit", "metrics"], "properties": {"model": {"type": "string", "minLength": 1}, "equipment_id": {"type": "string", "minLength": 1}, "target_signal_id": {"type": "string", "minLength": 1}, "unit": {"type": "string", "minLength": 1}, "metrics": {"$ref": "#/$defs/metric"}}},
    "failure": {"type": "object", "additionalProperties": false, "required": ["model", "equipment_id", "target_signal_id", "status", "reason", "split"], "properties": {"model": {"type": "string", "minLength": 1}, "equipment_id": {"type": "string", "minLength": 1}, "target_signal_id": {"type": "string", "minLength": 1}, "status": {"type": "string", "enum": ["failed", "inconclusive"]}, "reason": {"type": "string", "minLength": 1}, "split": {"type": "string", "enum": ["validation", "test"]}}},
    "runtime": {"type": "object", "additionalProperties": false, "required": ["validation_seconds", "test_seconds", "total_seconds", "p50_latency_ms", "p95_latency_ms", "latency_by_model", "peak_memory_bytes", "memory_source", "model_state_bytes", "output_size_bytes_excluding_result", "os", "python", "cpu", "calibration_source", "quantile_policy_by_model"], "properties": {"validation_seconds": {"type": "number", "minimum": 0}, "test_seconds": {"type": "number", "minimum": 0}, "p50_latency_ms": {"type": "number", "minimum": 0}, "p95_latency_ms": {"type": "number", "minimum": 0}, "total_seconds": {"type": "number", "minimum": 0}, "latency_by_model": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/latency"}}, "peak_memory_bytes": {"type": "integer", "minimum": 0}, "memory_source": {"type": "string", "enum": ["os.process_peak_working_set", "os.resource.ru_maxrss", "tracemalloc.fallback", "unavailable"]}, "model_state_bytes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 0}}, "output_size_bytes_excluding_result": {"type": "integer", "minimum": 0}, "os": {"type": "string", "minLength": 1}, "python": {"type": "string", "minLength": 1}, "cpu": {"type": "string"}, "calibration_source": {"type": "string", "minLength": 1}, "quantile_policy_by_model": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "enum": ["native", "validation-residual-by-lead"]}}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["quality_gate", "split", "origin_selection", "quantile_calibration", "quantile_policy_by_model"], "properties": {"quality_gate": {"type": "object", "additionalProperties": false, "required": ["status", "observation_record_count", "equipment_count", "checks"], "properties": {"status": {"const": "pass"}, "observation_record_count": {"type": "integer", "minimum": 1}, "equipment_count": {"type": "integer", "minimum": 1}, "checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}, "split": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["train", "validation", "test"], "properties": {"train": {"$ref": "#/$defs/splitBounds"}, "validation": {"$ref": "#/$defs/splitBounds"}, "test": {"$ref": "#/$defs/splitBounds"}}}}, "origin_selection": {"type": "object", "additionalProperties": false, "required": ["validation", "test"], "properties": {"validation": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/originSelection"}}, "test": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/originSelection"}}}}, "quantile_calibration": {"type": "string", "minLength": 1}, "quantile_policy_by_model": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "enum": ["native", "validation-residual-by-lead"]}}}},
    "splitBounds": {"type": "object", "additionalProperties": false, "required": ["start_index", "end_index"], "properties": {"start_index": {"type": "integer", "minimum": 0}, "end_index": {"type": "integer", "minimum": 1}}},
    "originSelection": {"type": "object", "additionalProperties": false, "required": ["count", "indices", "stride", "max_origins", "rule"], "properties": {"count": {"type": "integer", "minimum": 0}, "indices": {"type": "array", "items": {"type": "integer", "minimum": 0}}, "stride": {"type": "integer", "minimum": 1}, "max_origins": {"type": ["integer", "null"], "minimum": 1}, "rule": {"type": "string", "minLength": 1}}},
    "latency": {"type": "object", "additionalProperties": false, "required": ["call_count", "p50_ms", "p95_ms"], "properties": {"call_count": {"type": "integer", "minimum": 0}, "p50_ms": {"type": "number", "minimum": 0}, "p95_ms": {"type": "number", "minimum": 0}}}
  }
}
