{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "banto-ai Toto 2.0 controlled acceptance analyzer result",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "result_type", "analyzer_id", "analyzer_code_revision", "analyzer_config", "controlled_acceptance_status", "cross_model_ranking_allowed", "pairing", "tracks", "paired_deltas", "counts", "limitations"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "result_type": {"const": "toto2-controlled-acceptance"},
    "analyzer_id": {"const": "toto2-controlled-acceptance"},
    "analyzer_code_revision": {"$ref": "#/$defs/codeRevision"},
    "analyzer_config": {"$ref": "#/$defs/source"},
    "controlled_acceptance_status": {"enum": ["pass", "blocked"]},
    "cross_model_ranking_allowed": {"const": false},
    "pairing": {"type": "object", "additionalProperties": false, "required": ["key", "comparison", "truth_unavailable"], "properties": {"key": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "comparison": {"type": "string", "minLength": 1}, "truth_unavailable": {"type": "string", "minLength": 1}}},
    "tracks": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/track"}},
    "paired_deltas": {"type": "array", "items": {"$ref": "#/$defs/delta"}},
    "counts": {"type": "object", "additionalProperties": false, "required": ["tracks", "expected_cells", "cells", "expected_groups", "groups"], "properties": {"tracks": {"const": 4}, "expected_cells": {"const": 80}, "cells": {"type": "integer", "minimum": 0}, "expected_groups": {"type": "integer", "minimum": 1}, "groups": {"type": "integer", "minimum": 0}}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "source": {"type": "object", "additionalProperties": false, "required": ["kind", "path", "sha256"], "properties": {"kind": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "codeRevision": {"type": "object", "additionalProperties": false, "required": ["status", "head", "dirty", "diff_sha256"], "properties": {"status": {"const": "git"}, "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "dirty": {"const": false}, "diff_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "group": {"type": "object", "additionalProperties": false, "required": ["model", "equipment_id", "target_signal_id", "origin_sample", "origin_timestamp"], "properties": {"model": {"type": "string", "minLength": 1}, "equipment_id": {"type": "string", "minLength": 1}, "target_signal_id": {"type": "string", "minLength": 1}, "origin_sample": {"const": 384}, "origin_timestamp": {"type": "string", "minLength": 1}}},
    "qualityCounts": {"type": "object", "additionalProperties": false, "required": ["ok", "missing", "stale", "non_ok", "other", "finite_value_count", "model_observed_value_count"], "properties": {"ok": {"type": "integer", "minimum": 0}, "missing": {"type": "integer", "minimum": 0}, "stale": {"type": "integer", "minimum": 0}, "non_ok": {"type": "integer", "minimum": 0}, "other": {"type": "integer", "minimum": 0}, "finite_value_count": {"type": "integer", "minimum": 0}, "model_observed_value_count": {"type": "integer", "minimum": 0}}},
    "context": {"type": "object", "additionalProperties": false, "required": ["signals", "context_row_count", "expected_value_count", "source_finite_value_count", "model_observed_value_count"], "properties": {"signals": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {"$ref": "#/$defs/qualityCounts"}}}, "context_row_count": {"type": "integer", "minimum": 0}, "expected_value_count": {"type": "integer", "minimum": 0}, "source_finite_value_count": {"type": "integer", "minimum": 0}, "model_observed_value_count": {"type": "integer", "minimum": 0}}},
    "groupAudit": {"type": "object", "additionalProperties": false, "required": ["group", "expected_prediction_count", "observed_prediction_count", "valid_prediction_count", "availability", "status", "failure", "truth", "context", "expected_consumed_signal_set", "consumption_evidence", "non_ok_history_excluded_count", "padding_count", "input_semantics", "accuracy"], "properties": {"group": {"$ref": "#/$defs/group"}, "expected_prediction_count": {"type": "integer", "minimum": 1}, "observed_prediction_count": {"type": "integer", "minimum": 0}, "valid_prediction_count": {"type": "integer", "minimum": 0}, "availability": {"type": "number", "minimum": 0, "maximum": 1}, "status": {"enum": ["complete", "blocked", "failed", "inconclusive"]}, "failure": {"type": ["object", "null"], "additionalProperties": false, "required": ["status", "reason", "split"], "properties": {"status": {"enum": ["failed", "inconclusive"]}, "reason": {"type": "string", "minLength": 1}, "split": {"enum": ["validation", "test"]}}}, "truth": {"type": "object", "additionalProperties": false, "required": ["status", "quality"], "properties": {"status": {"enum": ["valid", "unavailable", "non_ok"]}, "quality": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}}}, "context": {"$ref": "#/$defs/context"}, "expected_consumed_signal_set": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "consumption_evidence": {"const": "static-contract"}, "non_ok_history_excluded_count": {"type": "integer", "minimum": 0}, "padding_count": {"type": "integer", "minimum": 0}, "input_semantics": {"type": "string", "minLength": 1}, "accuracy": {"type": "object", "additionalProperties": false, "required": ["mae", "status"], "properties": {"mae": {"type": ["number", "null"], "minimum": 0}, "status": {"enum": ["valid", "inconclusive"]}}}}},
    "cell": {"type": "object", "additionalProperties": false, "required": ["cell_id", "seed", "horizon", "context_length", "status", "source_artifacts", "groups"], "properties": {"cell_id": {"type": "string", "minLength": 1}, "seed": {"type": "integer", "minimum": 0}, "horizon": {"type": "integer", "minimum": 1}, "context_length": {"type": "integer", "minimum": 2}, "status": {"enum": ["pass", "blocked"]}, "source_artifacts": {"type": "array", "items": {"$ref": "#/$defs/source"}}, "groups": {"type": "array", "items": {"$ref": "#/$defs/groupAudit"}}, "failure": {"type": "string"}}},
    "track": {"type": "object", "additionalProperties": false, "required": ["track_id", "role", "matrix_id", "matrix_result", "source_artifacts", "dataset_sources", "status", "cells"], "properties": {"track_id": {"enum": ["control", "target-fault", "target-quality", "covariate-quality"]}, "role": {"type": "string", "minLength": 1}, "matrix_id": {"type": "string", "minLength": 1}, "matrix_result": {"$ref": "#/$defs/source"}, "source_artifacts": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/source"}}, "dataset_sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}, "status": {"enum": ["pass", "blocked"]}, "cells": {"type": "array", "minItems": 20, "maxItems": 20, "items": {"$ref": "#/$defs/cell"}}}},
    "delta": {"type": "object", "additionalProperties": false, "required": ["track_id", "cell_id", "group", "status", "availability_delta", "accuracy_delta", "truth_status", "ranking"], "properties": {"track_id": {"type": "string", "minLength": 1}, "cell_id": {"type": "string", "minLength": 1}, "group": {"$ref": "#/$defs/group"}, "status": {"enum": ["paired", "inconclusive"]}, "availability_delta": {"type": ["number", "null"]}, "accuracy_delta": {"type": ["object", "null"], "additionalProperties": false, "required": ["mae", "definition"], "properties": {"mae": {"type": "number"}, "definition": {"type": "string", "minLength": 1}}}, "truth_status": {"enum": ["valid", "inconclusive"]}, "ranking": {"const": "no-rank"}}}
}
}
