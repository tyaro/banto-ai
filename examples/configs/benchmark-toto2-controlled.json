    {"name": "ewma", "parameters": {"alpha": 0.3}},
    {"name": "holt-linear", "parameters": {"alpha": 0.8, "beta": 0.2}},
    {
      "name": "toto2",
      "quantile_policy": "native",
      "parameters": {
        "checkpoint_revision": "8306a9801cf98c0f5ffe4b2dcc8f496e616d84d9",
        "batch_size": 1,
        "device": "cpu",
        "local_files_only": true,
        "patch_size": 32
      }
